<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ p.personal.name }} – CV</title>
<style>
  @font-face { font-family: "Roboto"; font-weight: 400; src: url("fonts/roboto-latin-400-normal.woff"); }
  @font-face { font-family: "Roboto"; font-weight: 400; src: url("fonts/roboto-latin-ext-400-normal.woff"); }
  @font-face { font-family: "Roboto"; font-weight: 500; src: url("fonts/roboto-latin-500-normal.woff"); }
  @font-face { font-family: "Roboto"; font-weight: 700; src: url("fonts/roboto-latin-700-normal.woff"); }
  @font-face { font-family: "Roboto"; font-weight: 700; src: url("fonts/roboto-latin-ext-700-normal.woff"); }

  @page { size: A4; margin: 30pt 36pt 30pt 36pt; }
  * { box-sizing: border-box; }
  body { font-family: "Roboto", sans-serif; font-size: 10pt; line-height: 1.3; color: #000; margin: 0; }
  a { color: #1155cc; text-decoration: none; font-weight: 700; }

  header { position: relative; }
  header.with-photo { min-height: 112pt; padding-right: 120pt; }  /* room for the photo only when there is one */
  .photo { position: absolute; right: 0; top: 2pt; width: 108pt; height: 108pt; border-radius: 50%; object-fit: cover; }
  h1 { font-size: 21pt; font-weight: 700; color: #1f2937; margin: 0 0 4pt 0; line-height: 1.1; }
  .headline { font-size: 13pt; color: #1f2937; line-height: 1.25; margin: 0 0 5pt 0; }
  .contact { font-size: 10pt; line-height: 1.38; }

  h2 { font-size: 11.5pt; font-weight: 700; color: #1f2937; letter-spacing: 0.6pt; text-transform: uppercase;
       margin: 13pt 0 5pt 0; padding-bottom: 2pt; border-bottom: 1pt solid #1f2937; }
  h2.blue { border-bottom-color: #1155cc; }

  .skills p { margin: 0 0 1.5pt 0; }
  .label { font-weight: 700; }

  .entry { display: flex; margin-bottom: 7pt; page-break-inside: avoid; }
  .entry.split { page-break-inside: auto; }
  .when { width: 80pt; flex: none; color: #777; padding-left: 4pt; }
  .what { flex: 1; padding-right: 16pt; }
  .role { font-weight: 700; }
  .org { color: #1155cc; font-weight: 700; }
  .sub { color: #777; }
  ul { margin: 3pt 0 3pt 0; padding-left: 20pt; list-style: none; }
  li { margin-bottom: 2.5pt; position: relative; }
  li::before { content: "\2022"; position: absolute; left: -12pt; top: 0; font-size: 10pt; }
  .tech { margin-top: 2pt; }
  .langs { margin-top: 0; }
</style>
</head>
<body>
{# A profile from a CV import can lack a photo, links, dates or technologies:
   leave out what is empty instead of printing a bare label or separator. #}
<header{% if p.personal.get("photo") %} class="with-photo"{% endif %}>
  {% if p.personal.get("photo") %}<img class="photo" src="{{ p.personal.photo }}" alt="">{% endif %}
  <h1>{{ p.personal.name }}</h1>
  <div class="headline">{{ cv.headline }}</div>
  <div class="contact">
    {{ [p.personal.get("location"), p.personal.get("phone")] | select | join(" | ") }}
    {%- set links = [] %}
    {%- if p.personal.get("email") %}{% set links = links + [("mailto:" ~ p.personal.email, p.personal.email)] %}{% endif %}
    {%- if p.personal.get("linkedin_url") %}{% set links = links + [(p.personal.linkedin_url, "LinkedIn")] %}{% endif %}
    {%- if p.personal.get("github_url") %}{% set links = links + [(p.personal.github_url, "GitHub")] %}{% endif %}
    {%- if links %}<br>
    {% for href, text in links %}{% if not loop.first %} <span style="color:#1155cc;font-weight:700">|</span> {% endif %}<a href="{{ href }}">{{ text }}</a>{% endfor %}{% endif %}
    {%- if p.personal.get("work_authorization") %}<br>
    {{ p.personal.work_authorization }}{% endif %}
    {%- if p.personal.get("availability") %}<br>
    {{ p.personal.availability }}{% endif %}
  </div>
</header>

<h2>Technical Skills</h2>
<div class="skills">
{% for row in cv.skills %}  <p><span class="label">{{ row.label }}:</span> {{ row["items"] | join(" | ") }}</p>
{% endfor %}</div>

<h2>Work Experience</h2>
{% for e in experience %}
<div class="entry{% if e.bullets|length > 3 %} split{% endif %}">
  <div class="when">{% if e.get("start") or e.get("end") %}{{ e.get("start") }} –<br>{{ e.get("end") }}{% endif %}</div>
  <div class="what">
    <div class="role">{{ e.title }}</div>
    <div class="org">{{ [e.get("company"), e.get("location")] | select | join(", ") }}</div>
    {% if e.get("project") %}<div><span class="label">Project:</span> {{ e.project }}</div>{% endif %}
    <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% if e.technologies %}<div class="tech"><span class="label">Technologies used:</span> {{ e.technologies | join(" | ") }}</div>{% endif %}
  </div>
</div>
{% endfor %}

{% if projects %}
<h2 class="blue">Personal Projects</h2>
{% for pr in projects %}
<div class="entry">
  <div class="when">{% if pr.get("start") or pr.get("end") %}{{ pr.get("start") }} –<br>{{ pr.get("end") }}{% endif %}</div>
  <div class="what">
    <div class="role">{{ pr.name }}</div>
    {% if pr.get("subtitle") %}<div class="sub">{{ pr.subtitle }}</div>{% endif %}
    <ul>{% for b in pr.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% if pr.technologies %}<div class="tech"><span class="label">Technologies used:</span> {{ pr.technologies | join(" | ") }}</div>{% endif %}
  </div>
</div>
{% endfor %}
{% endif %}

{% if p.get("certifications") %}
<h2 class="blue">Certifications &amp; Continuous Learning</h2>
{% for c in p.certifications %}
<div class="entry">
  <div class="when">{{ c.status }}</div>
  <div class="what">
    <div class="role">{{ c.name }}</div>
    <div class="sub">{{ c.detail }}</div>
    {% if c.get("topics") %}<div style="margin-top:2pt">{{ c.topics }}</div>{% endif %}
  </div>
</div>
{% endfor %}
{% endif %}

{% if p.get("education") %}
<h2 class="blue">Education</h2>
{% for ed in p.education %}
<div class="entry">
  <div class="when">{{ ed.period }}</div>
  <div class="what">
    <div class="role">{{ ed.degree }}</div>
    <div class="sub">{{ ed.school }}</div>
  </div>
</div>
{% endfor %}
{% endif %}

{% set langs = p.get("languages") or {} %}
{% if langs.get("english") or langs.get("german") %}
<h2 class="blue">Language Skills</h2>
<div class="langs">{{ [("English (" ~ langs.english ~ ")") if langs.get("english") else "", ("German (" ~ langs.german ~ ")") if langs.get("german") else ""] | select | join(" | ") }}</div>
{% endif %}
</body>
</html>
