# ============================================================
# Applaut — PRODUCTION environment variables
# Copy to .env.production on the Oracle VM and fill in values.
# Never commit .env.production to version control.
# ============================================================

# --- Postgres (used by docker-compose.prod.yml) ---
POSTGRES_DB=applaut
POSTGRES_USER=applaut
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- JWT ---
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=applaut-documents
R2_PUBLIC_URL=https://your-r2-public-url

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- CORS: frontend origins (apex + www are both Cloudflare Pages custom domains) ---
BACKEND_CORS_ORIGINS=["https://www.lvamo.com","https://lvamo.com"]

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ProSho: GitHub App (sign-in, prosho.yaml reads, push webhooks) ---
# Values live in ~/.config/lvamo/prosho/ on the dev Mac; never commit them.
PROSHO_GITHUB_APP_ID=
PROSHO_GITHUB_APP_SLUG=lvamo-prosho
PROSHO_GITHUB_CLIENT_ID=
PROSHO_GITHUB_CLIENT_SECRET=
# base64 of the App's .pem private key, on one line
PROSHO_GITHUB_PRIVATE_KEY_B64=
PROSHO_GITHUB_WEBHOOK_SECRET=
PROSHO_GITHUB_REDIRECT_URI=https://api.prosho.lvamo.com/api/v1/prosho/auth/github/callback
# Closed beta: GitHub logins allowed to create an account (comma-separated)
PROSHO_SIGNUP_ALLOWLIST=
