# setup.sh copies this to .env and fills the first two; update.sh adds the
# SCORER_* / WRITER_* lines from backend/app/applaut/ai/models.lock.
# Never commit .env.

# Shared with the app VM's APPLAUT_LLM_API_KEY (one key for all model hosts).
LLAMA_API_KEY=

# This VM's WireGuard address; both servers are published only there.
WG_ADDRESS=10.8.0.2

# Cores for the models. A model host does nothing else: all 4.
# (On the app VM itself, as an optional lane: 1-3 and 3.)
LLAMA_CPUS=0-3
LLAMA_THREADS=4
