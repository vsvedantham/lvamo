# Copy to model-host/.env on the model VM. Never commit .env.

# Shared with the app VM's APPLAUT_LLM_API_KEY. Generate with: openssl rand -hex 32
LLAMA_API_KEY=

# This VM's WireGuard address (the port is published only there)
WG_ADDRESS=10.8.0.2

LLAMA_MODEL_FILE=Qwen3.5-9B-Q4_0.gguf
LLAMA_ALIAS=qwen3.5-9b-q4_0

# Cores for the model. 1-3 / 3 leaves core 0 for the OS; on a VM that does
# nothing else, 0-3 / 4 is about a third faster.
LLAMA_CPUS=1-3
LLAMA_THREADS=3
